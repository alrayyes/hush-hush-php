{
  "name": "hush-hush-php-tooling",
  "private": true,
  "description": "Not a JavaScript project. This exists so commitlint can resolve the shared config it extends, which bunx alone cannot do, and so Prettier, markdownlint and lefthook are pinned like everything else.",
  "scripts": {
    "audit": "bun audit",
    "format:check": "prettier --check \"**/*.{md,yml,yaml}\"",
    "lint:md": "markdownlint-cli2",
    "prepare": "lefthook install",
    "sort-package-json:check": "sort-package-json --check"
  },
  "overrides": {
    "katex": "0.19.0",
    "smol-toml": "1.9.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.24.0",
    "prettier": "3.9.10",
    "sort-package-json": "4.1.0"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "lefthook"
  ]
}
