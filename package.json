{
  "name": "hush-hush-php-tooling",
  "private": true,
  "description": "Not a JavaScript project. This exists so commitlint can resolve the shared config it extends, which bunx alone cannot do, and so Prettier, markdownlint and lefthook are pinned like everything else.",
  "scripts": {
    "audit": "bun audit --ignore GHSA-vfj7-8cjw-p6xm",
    "format:check": "prettier --check \"**/*.{md,yml,yaml}\"",
    "lint:md": "markdownlint-cli2",
    "prepare": "lefthook install",
    "sort-package-json:check": "sort-package-json --check",
    "test:hooks": "./scripts/test-pre-commit-staged-only.sh"
  },
  "overrides": {
    "katex": "0.19.0",
    "smol-toml": "1.9.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "lefthook": "2.1.16",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.9",
    "sort-package-json": "4.0.0"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "lefthook"
  ]
}
